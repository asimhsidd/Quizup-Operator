# Origin of the KWIZ backend. Leave empty for local dev (Vite proxies to localhost:3001).
# Production: https://api.kwiz.live (build-time; baked into the bundle; CI sets it)
VITE_BACKEND_URL=

# Dev only: where Vite proxies /api and /socket.io (default http://localhost:3001)
# VITE_PROXY_TARGET=https://play.kwiz.live
